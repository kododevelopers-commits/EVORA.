# Copy this file to ".env" in the same folder, then fill in real values.
# ".env" is where your real secrets live — never commit it or share it.

# ---- Server ----
PORT=3000

# ---- CORS (only needed if the frontend is hosted elsewhere) ----
# The site is normally served by this same server, which needs no CORS at all.
# If you host the HTML somewhere else, list its origin(s) here, comma separated:
#   CORS_ORIGINS=https://www.evora.example,https://evora.example
# Anything not listed gets no CORS headers and cannot read API responses.
CORS_ORIGINS=

# Local origins (http://localhost:*, http://127.0.0.1:*, and file:// pages)
# are accepted by default, so the site works when you open it from VS Code
# Live Server or by double-clicking an .html file. Set this to false to allow
# ONLY the origins listed in CORS_ORIGINS above.
CORS_ALLOW_LOCAL=true

# ---- Admin dashboard ----
# Required to sign in at /admin.html. Use any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, /admin.html and the /api/orders + /api/contacts + /api/stats
# + status-update endpoints refuse all requests (fail-closed).
# The key is sent as the x-admin-key header; query-string keys are not accepted.
ADMIN_API_KEY=

# ===========================================================================
# Email
# ===========================================================================
# Two things happen by email:
#
#   1. A COMPLAINT (or any message from the contact form) is delivered to
#      NOTIFY_EMAIL below, with the customer set as the reply-to address —
#      so pressing "Reply" answers them directly.
#
#   2. An ORDER delivers TWO emails:
#      a. to NOTIFY_EMAIL below (you), with the customer as reply-to, and
#      b. to the customer, confirming their order, with the shop as reply-to.
#
# Leave EMAIL_PROVIDER blank and the server prints emails to the console
# instead of sending them — handy while you're testing locally.
#
# EMAIL_PROVIDER can be "gmail", "sendgrid", "brevo" or "smtp".

EMAIL_PROVIDER=

# --- If EMAIL_PROVIDER=gmail ---
# 1. Turn on 2-Step Verification on the Gmail account you want to send from:
#    https://myaccount.google.com/security
# 2. Create an "App Password" (Google Account > Security > App passwords).
# 3. Put that 16-character app password below (NOT your normal Gmail password).
#    Type it without spaces.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- If EMAIL_PROVIDER=sendgrid ---
# 1. Create a free SendGrid account: https://signup.sendgrid.com/
# 2. Create an API key: Settings > API Keys > Create API Key.
# 3. Verify a sender email address: Settings > Sender Authentication.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- If EMAIL_PROVIDER=brevo ---
# Recommended if the shop will actually take orders: 300 emails/day free,
# no credit card, and much better deliverability than Gmail from a server.
# 1. Create a free account: https://www.brevo.com/
# 2. Add your sending address under Senders & IPs and click the link Brevo
#    emails you to verify it.
# 3. Brevo dashboard > SMTP & API > SMTP — copy the *login* and create an
#    *SMTP key*. Neither is your Brevo account email or password.
# 4. Fill in the four values below. Port 587 uses STARTTLS (normal choice);
#    use 465 if your host blocks 587.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=

# --- If EMAIL_PROVIDER=smtp (any other mail provider) ---
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false            <- true for port 465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=                   <- optional, defaults to SMTP_USER

# Where order + contact notifications get sent (your own inbox).
# This is also the reply-to address on the order confirmation the customer
# receives, so their "Reply" comes straight back to you.
NOTIFY_EMAIL=

# ---- Public base URL ----
# Used in customer-facing emails for the "Track Your Order" button and any
# other absolute links. In production set this to your real domain, e.g.
#   PUBLIC_BASE_URL=https://evora.example.com
# Leave blank while testing locally to fall back to http://localhost:3000.
PUBLIC_BASE_URL=

# ---- Persistent storage (only needed on a host with an ephemeral disk) ----
# Locally, orders and complaints live in data/*.json. On Render's free tier
# the filesystem is wiped on every restart, so point these at a free Upstash
# Redis database instead:
#   https://console.upstash.com/ -> Create Database -> Redis
#   -> open it -> "REST API" section -> copy the URL and the token.
# Leave both blank locally and the JSON files are used, exactly as before.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
